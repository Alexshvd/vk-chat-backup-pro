# Токен доступа сообщества (с правами messages)
# Создать: Управление сообществом → Работа с API → Ключи доступа
VK_TOKEN=ваш_community_token_сюда

# ID сообщества (число из vk.com/club<ID>)
GROUP_ID=ваш_group_id_сюда

# ID чата/пользователя для бэкапа (peer_id)
# Для беседы: 2000000000 + chat_id
# Для личного чата: id пользователя
PEER_ID=2000000001
